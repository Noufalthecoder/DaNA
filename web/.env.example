# Copy this file to .env.local and fill in your Supabase values
# (Supabase: Project Settings -> API). Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: shared password of the 4 demo users (khalid/fatima/mariam/doh@dana.demo).
# When set, "UAE PASS (demo)" signs in to the real database so all roles share data.
VITE_DEMO_PASSWORD=
