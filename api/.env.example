# Copy to api/.env and fill in. api/.env is git-ignored.
SUPABASE_URL=https://your-project.supabase.co
# public key: used to call the database AS the signed-in user (privacy rules apply)
SUPABASE_ANON_KEY=your-anon-public-key
# SECRET: server-only jobs (Malaffi ingestion). Never put this in the web app or GitHub.
SUPABASE_SERVICE_ROLE_KEY=
# where the web app runs (comma-separated), for CORS
ALLOWED_ORIGINS=http://localhost:5173,https://dana-gamma-seven.vercel.app
